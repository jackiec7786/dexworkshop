# Neon Postgres (set by Vercel Neon integration, or paste from Neon dashboard)
DATABASE_URL=postgresql://...

# Neon Auth / Stack Auth (from Neon dashboard → Auth → API Keys)
NEXT_PUBLIC_STACK_PROJECT_ID=...
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=...
STACK_SECRET_SERVER_KEY=...

# Vercel Blob (set automatically by Vercel Blob integration)
BLOB_READ_WRITE_TOKEN=...
